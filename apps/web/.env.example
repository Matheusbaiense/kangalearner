# Copy to .env.local and fill in. Never commit secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test keys for now) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COUNTRY_DEFAULT=AU
NEXT_PUBLIC_STATE_DEFAULT=WA

# --- Upstash Redis (rate limiting) ---
# REQUIRED in production: without these vars rate limiting fails closed (429 on all limited routes).
# Get free credentials at https://console.upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Cron / Security ---
# Required: /api/ping returns 401 when unset.
CRON_SECRET=
