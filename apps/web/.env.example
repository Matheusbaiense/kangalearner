# Copy to .env.local and fill in. Never commit secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test keys for now) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COUNTRY_DEFAULT=AU
NEXT_PUBLIC_STATE_DEFAULT=WA

# --- Upstash Redis (rate limiting) ---
# Optional. When set, activates serverless-safe rate limiting via Upstash Redis.
# Without these vars the app falls back to in-memory rate limiting (OK for dev,
# NOT suitable for multi-instance production). Get free credentials at:
# https://console.upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron / Security ---
# REQUIRED: absence disables auth check on /api/ping entirely.
CRON_SECRET=
