# Mobile Supabase sync
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mobile ads master switches
EXPO_PUBLIC_KANGA_ADS_ENABLED=true
EXPO_PUBLIC_KANGA_DIRECT_ADS_ENABLED=true
EXPO_PUBLIC_KANGA_GOOGLE_ADS_ENABLED=true

# Google Ad Manager first, AdMob fallback. Leave production IDs empty until the
# AdMob/GAM accounts and app-ads.txt are ready.
EXPO_PUBLIC_GAM_HOME_TOP_ID=
EXPO_PUBLIC_GAM_LEARN_INLINE_ID=
EXPO_PUBLIC_GAM_PRACTICE_INLINE_ID=
EXPO_PUBLIC_GAM_MOCK_RESULT_ID=

EXPO_PUBLIC_ADMOB_HOME_TOP_BANNER_ID=
EXPO_PUBLIC_ADMOB_LEARN_INLINE_BANNER_ID=
EXPO_PUBLIC_ADMOB_PRACTICE_INLINE_BANNER_ID=
EXPO_PUBLIC_ADMOB_MOCK_RESULT_BANNER_ID=
