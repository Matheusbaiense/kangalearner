{
  "name": "kangalearner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "smoke:static": "node scripts/smoke-static-site.mjs",
    "prebuild": "node scripts/validate-questions.cjs && node scripts/convert-questions.cjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "format:check": "prettier --check index.html \"assets/js/**/*.js\" \"assets/css/**/*.css\" \"e2e/**/*.js\" playwright.config.js",
    "legacy:build": "node scripts/build.mjs",
    "validate:questions": "node scripts/validate-questions.cjs",
    "gen:core-questions": "node scripts/convert-questions.cjs",
    "optimize:images": "node scripts/optimize-social-images.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.3.3",
    "puppeteer": "24.42.0",
    "sharp": "^0.34.5",
    "terser": "^5.39.0",
    "turbo": "^2.1.3"
  }
}
