{
  "name": "kangalearner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @kanga/web run test:e2e",
    "gen:questions-json": "tsx scripts/gen-questions-json.ts"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "ws@^8": ">=8.20.1",
      "brace-expansion@^5": ">=5.0.6",
      "postcss": ">=8.5.10",
      "@xmldom/xmldom": ">=0.8.13",
      "fast-xml-parser": ">=5.7.0",
      "tar": ">=7.5.11",
      "send": ">=0.19.0",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.19.3",
    "turbo": "^2.9.14"
  }
}