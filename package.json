{
  "name": "kangalearner",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "check:static-links": "node scripts/check-static-links.mjs",
    "smoke:static": "node scripts/smoke-static-site.mjs",
    "prebuild": "node scripts/validate-questions.cjs && node scripts/convert-questions.cjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier -w .",
    "format:check": "prettier --check index.html \"assets/js/**/*.js\" \"assets/css/**/*.css\" \"e2e/**/*.js\" \"src/**/*.js\" playwright.config.js vite.config.js",
    "legacy:build": "node scripts/build.mjs",
    "validate:questions": "node scripts/validate-questions.cjs",
    "gen:core-questions": "node scripts/convert-questions.cjs",
    "optimize:images": "node scripts/optimize-social-images.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "site:dev": "vite",
    "site:build": "vite build",
    "site:preview": "vite preview --port 5174 --strictPort"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "ws@^8": ">=8.20.1",
      "brace-expansion@^5": ">=5.0.6",
      "postcss": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.3.3",
"sharp": "^0.34.5",
    "terser": "^5.47.1",
    "turbo": "^2.9.14",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
